{
  "name": "matesoul-ai-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "mcp": "node dist/src/mcp/web-server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:live-mcp": "tsx scripts/live-mcp.ts",
    "test:live-gateway": "tsx scripts/live-gateway.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "cheerio": "1.2.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.18.13",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
