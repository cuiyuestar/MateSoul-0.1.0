# Test suites, validation scenes, probes, SDK samples and the vendored package
# internals are versioned: a clone must be able to run the same editors, tests
# and debug tooling as the machine the snapshot came from.

# Blender local recovery files.
*.blend1
*.blend2

# Local test binaries and runner crash reports.
mono_crash.*
*.apk
*.aab
*.unitypackage
*.blend
*.zip

# Shipped asset packages stay local; the plans and reports next to them are versioned.
项目沉淀资料/资产交付/

# Art source: only the current Lengyue production DCC chain is versioned.
# Everything else under ArtSource (legacy projects, wardrobe history, EyeLab
# experiments, delivery bundles) stays local.
/ArtSource/*
!/ArtSource/LocalStudyOnly/
/ArtSource/LocalStudyOnly/*
!/ArtSource/LocalStudyOnly/Onigawara_Lengyue_20261012/
/ArtSource/LocalStudyOnly/Onigawara_Lengyue_20261012/*
!/ArtSource/LocalStudyOnly/Onigawara_Lengyue_20261012/eye_shape_reference_v12_dcc_real/
/ArtSource/LocalStudyOnly/Onigawara_Lengyue_20261012/eye_shape_reference_v12_dcc_real/*
